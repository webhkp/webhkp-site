---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectCover from '../../components/ProjectCover.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { id: project.id },
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const hasLink = (v?: string) => Boolean(v && v !== '#');
---

<BaseLayout title={d.title} description={d.description}>
	<article style={`--c:${d.accent}`}>
		<header class="p-hero">
			<div class="container">
				<a href="/projects" class="back mono" data-reveal><Icon name="arrow-left" size={14} /> All projects</a>
				<div class="p-head">
					<div class="p-titles">
						<p class="eyebrow" data-reveal style="--d:1">{d.category} · {d.year}</p>
						<h1 class="display-xl" data-reveal style="--d:2">{d.title}</h1>
						<p class="lede" data-reveal style="--d:3">{d.description}</p>
					</div>
					<div class="p-actions" data-reveal style="--d:4">
						{
							hasLink(d.url) && (
								<a class="btn btn-primary" href={d.url} target="_blank" rel="noopener">
									Visit project <Icon name="arrow-up-right" size={16} />
								</a>
							)
						}
						{
							hasLink(d.repo) && (
								<a class="btn btn-ghost" href={d.repo} target="_blank" rel="noopener">
									<Icon name="github" size={16} /> Source
								</a>
							)
						}
					</div>
				</div>

				<dl class="facts" data-reveal style="--d:5">
					<div><dt class="mono">Role</dt><dd>{d.role}</dd></div>
					<div><dt class="mono">Year</dt><dd>{d.year}</dd></div>
					<div>
						<dt class="mono">Status</dt>
						<dd class:list={[d.status === 'Live' && 'live']}>{d.status}</dd>
					</div>
					<div><dt class="mono">Category</dt><dd>{d.category}</dd></div>
				</dl>

				<div class="cover-wrap" data-reveal="scale" style="--d:2">
					<ProjectCover title={d.title} accent={d.accent} pattern={d.pattern} size="lg" />
				</div>

				{
					d.metrics.length > 0 && (
						<ul class="metrics">
							{d.metrics.map((m, i) => (
								<li data-reveal style={`--d:${i}`}>
									<span class="m-value">{m.value}</span>
									<span class="m-label muted">{m.label}</span>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</header>

		<div class="container body">
			<div class="prose" data-reveal>
				<Content />
			</div>
			<aside class="side">
				<div class="side-card card" data-reveal>
					<p class="eyebrow">Tech stack</p>
					<ul class="stack-list">
						{d.stack.map((s) => <li>{s}</li>)}
					</ul>
				</div>
				<div class="side-card card" data-reveal style="--d:1">
					<p class="eyebrow">Tags</p>
					<div class="chip-list">{d.tags.map((t) => <span class="chip">{t}</span>)}</div>
				</div>
				<a class="side-card card spot cta" href="/contact" data-reveal style="--d:2">
					<strong>Need something similar?</strong>
					<span class="muted">Let’s talk about your project.</span>
					<Icon name="arrow-right" size={18} />
				</a>
			</aside>
		</div>

		<nav class="container next-wrap" aria-label="Next project">
			<a class="next card spot" href={`/projects/${next.id}`} style={`--c:${next.data.accent}`} data-reveal>
				<span class="mono muted">Next project</span>
				<span class="next-title">{next.data.title}</span>
				<span class="next-arrow" aria-hidden="true"><Icon name="arrow-right" size={28} /></span>
			</a>
		</nav>
	</article>
</BaseLayout>

<style>
	.p-hero {
		position: relative;
		padding-top: calc(var(--header-h) + clamp(40px, 6vw, 80px));
		overflow: hidden;
	}
	.p-hero::before {
		content: '';
		position: absolute;
		z-index: -1;
		top: -260px;
		left: 50%;
		width: 900px;
		height: 600px;
		translate: -50% 0;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 22%, transparent), transparent);
		filter: blur(30px);
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 32px;
		font-size: 0.8rem;
		color: var(--muted);
		transition: color 0.2s, gap 0.25s var(--ease);
	}
	.back:hover {
		color: var(--text);
		gap: 12px;
	}
	.p-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px 48px;
	}
	.p-titles {
		display: grid;
		gap: 20px;
		max-width: 820px;
	}
	.p-titles .eyebrow::before {
		background: var(--c);
	}
	.p-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.p-actions .btn-primary {
		--btn-bg: var(--c);
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 48px 0 32px;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}
	.facts div {
		display: grid;
		gap: 4px;
		padding: 18px 20px 18px 0;
	}
	.facts div + div {
		padding-left: 20px;
		border-left: 1px solid var(--border);
	}
	.facts dt {
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--faint);
	}
	.facts dd {
		margin: 0;
		font-weight: 500;
	}
	.facts .live {
		color: #3ddc84;
	}
	.cover-wrap {
		padding: 10px;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--surface);
	}
	.metrics {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin-top: 16px;
	}
	.metrics li {
		display: grid;
		gap: 6px;
		padding: 24px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--surface);
	}
	.m-value {
		font-family: var(--ff-display);
		font-weight: 600;
		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--c);
	}

	.body {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: clamp(32px, 6vw, 80px);
		padding-block: clamp(56px, 8vw, 96px);
		align-items: start;
	}
	.side {
		position: sticky;
		top: calc(var(--header-h) + 24px);
		display: grid;
		gap: 16px;
	}
	.side-card {
		display: grid;
		gap: 14px;
		padding: 22px;
	}
	.stack-list {
		display: grid;
	}
	.stack-list li {
		padding: 9px 0;
		border-top: 1px solid var(--border);
		font-size: 0.95rem;
	}
	.stack-list li:first-child {
		border-top: 0;
	}
	.cta {
		gap: 4px;
		transition: transform 0.4s var(--ease), border-color 0.3s;
	}
	.cta:hover {
		transform: translateY(-3px);
		border-color: var(--border-strong);
	}
	.cta :global(svg) {
		margin-top: 8px;
		color: var(--accent-text);
	}

	.next-wrap {
		padding-bottom: clamp(56px, 8vw, 96px);
	}
	.next {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 8px 24px;
		align-items: center;
		padding: clamp(28px, 5vw, 48px);
		border-radius: var(--radius-lg);
	}
	.next .mono {
		font-size: 0.8rem;
		grid-column: 1;
	}
	.next-title {
		grid-column: 1;
		font-family: var(--ff-display);
		font-weight: 600;
		font-size: clamp(2.2rem, 6vw, 4.5rem);
		letter-spacing: -0.045em;
		line-height: 1;
		transition: color 0.3s;
	}
	.next:hover .next-title {
		color: var(--c);
	}
	.next-arrow {
		grid-column: 2;
		grid-row: 1 / span 2;
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
		transition: transform 0.5s var(--ease-spring), background-color 0.3s, color 0.3s;
	}
	.next:hover .next-arrow {
		background: var(--c);
		color: #0b0d02;
		border-color: transparent;
		transform: translateX(6px) rotate(-45deg);
	}

	@media (max-width: 900px) {
		.body {
			grid-template-columns: 1fr;
		}
		.side {
			position: static;
		}
		.facts {
			grid-template-columns: 1fr 1fr;
		}
		.facts div:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.facts div:nth-child(n + 3) {
			border-top: 1px solid var(--border);
		}
	}
	@media (max-width: 560px) {
		.metrics {
			grid-template-columns: 1fr;
		}
		.next-arrow {
			width: 52px;
			height: 52px;
		}
	}
</style>
