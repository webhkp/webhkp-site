---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE, SOCIALS } from '../data/site';
import { BIO, EXPERIENCE, PRINCIPLES, STACK } from '../data/about';
import { BLOGS } from '../data/blogs';
import { CERTIFICATIONS } from '../data/certifications';

const levelLabel = { 1: 'Exploring', 2: 'Proficient', 3: 'Expert' } as const;
const featuredCerts = CERTIFICATIONS.filter((c) => c.featured);
---

<BaseLayout title="About" description="The engineer behind WEBHKP: background, tech stack, principles and where to find me online.">
	<PageHero eyebrow="About" title={`${BIO.headline.replace('educator.', "<span class='serif-em'>educator.</span>")}`} lede={BIO.intro}>
		<div class="hero-socials">
			{
				SOCIALS.map((s) => (
					<a class="social-pill" href={s.href} target="_blank" rel="noopener">
						<Icon name={s.icon} size={16} />
						{s.label}
					</a>
				))
			}
		</div>
	</PageHero>

	<!-- ================= BIO ================= -->
	<section class="section-tight">
		<div class="container bio">
			<aside class="id-card card" data-reveal="scale" data-tilt>
				<div class="id-top">
					<span class="id-mark" aria-hidden="true">
						<span></span><span></span>
					</span>
					<span class="mono id-label">ID · {SITE.name}</span>
				</div>
				<div class="id-monogram" aria-hidden="true">W</div>
				<dl class="id-rows">
					<div><dt class="mono">Role</dt><dd>Software consultant</dd></div>
					<div><dt class="mono">Based</dt><dd>{SITE.location}</dd></div>
					<div><dt class="mono">Focus</dt><dd>Cloud · Platforms · Backend</dd></div>
					<div>
						<dt class="mono">Status</dt>
						<dd class="status"><span class="pulse"></span> {SITE.availability.label}</dd>
					</div>
				</dl>
				<div class="id-barcode" aria-hidden="true">
					{Array.from({ length: 38 }).map((_, i) => <span style={`--w:${(i * 7) % 4 + 1}px`} />)}
				</div>
			</aside>

			<div class="bio-copy">
				{BIO.paragraphs.map((p, i) => <p data-reveal style={`--d:${i}`}>{p}</p>)}

				<div class="currently" data-reveal>
					<p class="eyebrow">Currently</p>
					<ul>
						{
							BIO.currently.map((c) => (
								<li>
									<span class="mono muted">{c.label}</span>
									<span>{c.value}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ================= TECH STACK ================= -->
	<section class="section">
		<div class="container">
			<SectionHeading
				eyebrow="Tech stack"
				title="Tools I’ve used <span class='serif-em'>in production.</span>"
				lede="The languages, platforms and tools I’ve shipped real systems with. The meter shows depth of experience."
			/>

			<ul class="legend mono" aria-label="Legend">
				{
					([3, 2, 1] as const).map((l) => (
						<li>
							<span class="meter" data-level={l} aria-hidden="true">
								<i />
								<i />
								<i />
							</span>
							{levelLabel[l]}
						</li>
					))
				}
			</ul>

			<div class="stack">
				{
					STACK.map((group, gi) => (
						<div class="stack-group card spot" data-reveal style={`--d:${gi}`}>
							<header>
								<span class="stack-icon">
									<Icon name={group.icon} size={20} />
								</span>
								<h3>{group.group}</h3>
								<span class="mono count">{String(group.items.length).padStart(2, '0')}</span>
							</header>
							<ul>
								{group.items.map((item) => (
									<li>
										<span>{item.name}</span>
										<span class="meter" data-level={item.level} title={levelLabel[item.level]}>
											<i />
											<i />
											<i />
											<span class="sr-only">{levelLabel[item.level]}</span>
										</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ================= PRINCIPLES ================= -->
	<section class="section-tight">
		<div class="container">
			<SectionHeading eyebrow="Principles" title="How I approach <span class='serif-em'>every system.</span>" />
			<div class="principles">
				{
					PRINCIPLES.map((p, i) => (
						<div class="principle" data-reveal style={`--d:${i}`}>
							<span class="p-icon">
								<Icon name={p.icon} size={22} />
							</span>
							<h3>{p.title}</h3>
							<p class="muted">{p.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- ================= EXPERIENCE ================= -->
	<section class="section">
		<div class="container exp-wrap">
			<div class="exp-head">
				<SectionHeading eyebrow="Experience" title="The road <span class='serif-em'>so far.</span>" />
				<div class="cert-mini" data-reveal>
					<p class="eyebrow">Certified</p>
					<ul>
						{
							featuredCerts.map((c) => (
								<li>
									<Icon name="award" size={16} />
									<span>{c.title}</span>
								</li>
							))
						}
					</ul>
					<a class="link-arrow" href="/certifications">
						All {CERTIFICATIONS.length} certifications <Icon name="arrow-right" size={16} />
					</a>
				</div>
			</div>
			<ol class="timeline">
				{
					EXPERIENCE.map((e, i) => (
						<li data-reveal style={`--d:${i}`}>
							<span class="mono period">{e.period}</span>
							<div>
								<h3>{e.role}</h3>
								<p class="org">{e.org}</p>
								<p class="muted">{e.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- ================= FIND ME ONLINE ================= -->
	<section class="section-tight">
		<div class="container">
			<SectionHeading
				eyebrow="Find me online"
				title="Let’s <span class='serif-em'>connect.</span>"
				lede="Videos, threads, code and long-form writing. Pick your channel."
			/>
			<div class="socials">
				{
					SOCIALS.map((s, i) => (
						<a class="social card spot" href={s.href} target="_blank" rel="noopener" data-reveal style={`--d:${i}`}>
							<span class="social-icon">
								<Icon name={s.icon} size={26} />
							</span>
							<span class="social-text">
								<strong>{s.label}</strong>
								<span class="mono muted">{s.handle}</span>
							</span>
							<span class="social-go" aria-hidden="true">
								<Icon name="arrow-up-right" size={18} />
							</span>
						</a>
					))
				}
				<a class="social card spot" href={`mailto:${SITE.email}`} data-reveal style={`--d:${SOCIALS.length}`}>
					<span class="social-icon">
						<Icon name="mail" size={26} />
					</span>
					<span class="social-text">
						<strong>Email</strong>
						<span class="mono muted">{SITE.email}</span>
					</span>
					<span class="social-go" aria-hidden="true">
						<Icon name="arrow-up-right" size={18} />
					</span>
				</a>
			</div>

			<div class="network">
				{BLOGS.map((b, i) => <BlogCard blog={b} index={i} compact />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 8px;
	}
	.social-pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 9px 16px;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: color-mix(in srgb, var(--surface) 60%, transparent);
		font-size: 0.9rem;
		font-weight: 500;
		transition: background-color 0.2s, color 0.2s, transform 0.25s var(--ease);
	}
	.social-pill:hover {
		background: var(--accent);
		color: var(--accent-ink);
		border-color: transparent;
		transform: translateY(-2px);
	}

	/* ---------- Bio ---------- */
	.bio {
		display: grid;
		grid-template-columns: 380px 1fr;
		gap: clamp(32px, 6vw, 88px);
		align-items: start;
	}
	.id-card {
		position: sticky;
		top: calc(var(--header-h) + 32px);
		display: grid;
		gap: 22px;
		padding: 26px;
		border-radius: var(--radius-lg);
		background:
			radial-gradient(90% 60% at 100% 0%, var(--accent-soft), transparent 60%),
			var(--surface);
		transition: transform 0.2s ease-out;
	}
	.id-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.id-mark {
		position: relative;
		width: 30px;
		height: 30px;
	}
	.id-mark span:first-child {
		position: absolute;
		inset: 0 8px 8px 0;
		border: 2px solid var(--text);
		border-radius: 7px;
	}
	.id-mark span:last-child {
		position: absolute;
		inset: 10px 0 0 10px;
		background: var(--accent);
		border-radius: 7px;
	}
	.id-label {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--faint);
	}
	.id-monogram {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius);
		background:
			linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 22px 22px,
			linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 22px 22px,
			var(--surface-2);
		border: 1px solid var(--border);
		font-family: var(--ff-display);
		font-weight: 700;
		font-size: 9rem;
		line-height: 1;
		letter-spacing: -0.08em;
		color: transparent;
		-webkit-text-stroke: 2px var(--accent-text);
		text-shadow: 0 0 60px var(--glow);
	}
	.id-rows {
		display: grid;
		gap: 12px;
		margin: 0;
	}
	.id-rows div {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding-bottom: 12px;
		border-bottom: 1px dashed var(--border-strong);
		font-size: 0.92rem;
	}
	.id-rows dt {
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
		padding-top: 2px;
	}
	.id-rows dd {
		margin: 0;
		text-align: right;
	}
	.id-rows .status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.id-barcode {
		display: flex;
		align-items: stretch;
		gap: 3px;
		height: 34px;
		opacity: 0.6;
	}
	.id-barcode span {
		width: var(--w);
		background: var(--text);
	}

	.bio-copy {
		display: grid;
		gap: 24px;
		font-size: clamp(1.08rem, 1.5vw, 1.25rem);
		line-height: 1.7;
		color: var(--muted);
	}
	.bio-copy > p:first-child {
		color: var(--text);
		font-size: 1.1em;
	}
	.currently {
		display: grid;
		gap: 16px;
		margin-top: 16px;
		padding: 24px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--surface);
		font-size: 1rem;
	}
	.currently ul {
		display: grid;
		gap: 12px;
	}
	.currently li {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: 16px;
		color: var(--text);
	}
	.currently li .mono {
		font-size: 0.8rem;
		padding-top: 3px;
	}

	/* ---------- Stack ---------- */
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin: -16px 0 28px;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.legend li {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}
	.stack {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: 16px;
	}
	.stack-group {
		padding: 24px;
	}
	.stack-group header {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 18px;
	}
	.stack-icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: var(--surface-2);
		color: var(--accent-text);
	}
	.stack-group h3 {
		font-size: 1.2rem;
		letter-spacing: -0.02em;
	}
	.count {
		margin-left: auto;
		font-size: 0.75rem;
		color: var(--faint);
	}
	.stack-group ul {
		display: grid;
	}
	.stack-group li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 0;
		border-top: 1px solid var(--border);
		font-size: 0.95rem;
	}
	.meter {
		display: inline-flex;
		gap: 3px;
	}
	.meter i {
		width: 18px;
		height: 6px;
		border-radius: 3px;
		background: var(--surface-3);
		transition: background-color 0.3s;
	}
	.meter[data-level='1'] i:nth-child(-n + 1),
	.meter[data-level='2'] i:nth-child(-n + 2),
	.meter[data-level='3'] i:nth-child(-n + 3) {
		background: var(--accent-text);
	}
	.stack-group li:hover .meter i {
		box-shadow: 0 0 10px -2px var(--glow);
	}

	/* ---------- Principles ---------- */
	.principles {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-top: 1px solid var(--border);
	}
	.principle {
		display: grid;
		gap: 12px;
		align-content: start;
		padding: 32px 24px 8px 0;
	}
	.principle + .principle {
		padding-left: 24px;
		border-left: 1px solid var(--border);
	}
	.p-icon {
		color: var(--accent-text);
	}
	.principle h3 {
		font-size: 1.3rem;
	}

	/* ---------- Experience ---------- */
	.exp-wrap {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: clamp(32px, 6vw, 88px);
		align-items: start;
	}
	.exp-head {
		position: sticky;
		top: calc(var(--header-h) + 32px);
	}
	.cert-mini {
		display: grid;
		gap: 16px;
		justify-items: start;
		padding: 24px;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--surface);
	}
	.cert-mini ul {
		display: grid;
		gap: 10px;
	}
	.cert-mini li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		font-size: 0.95rem;
	}
	.cert-mini li :global(svg) {
		flex: none;
		margin-top: 4px;
		color: var(--accent-text);
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: 6px;
		top: 8px;
		bottom: 8px;
		width: 1px;
		background: linear-gradient(to bottom, var(--accent), var(--border-strong) 30%, transparent);
	}
	.timeline li {
		position: relative;
		display: grid;
		gap: 10px;
		padding: 0 0 44px 40px;
	}
	.timeline li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 6px;
		width: 13px;
		height: 13px;
		border-radius: 4px;
		border: 2px solid var(--accent-text);
		background: var(--bg);
		transform: rotate(45deg);
	}
	.timeline li:first-child::before {
		background: var(--accent);
		box-shadow: 0 0 16px var(--glow);
	}
	.period {
		font-size: 0.78rem;
		color: var(--faint);
		letter-spacing: 0.06em;
	}
	.timeline h3 {
		font-size: 1.5rem;
	}
	.org {
		color: var(--accent-text);
		font-weight: 500;
		margin: 4px 0 8px;
	}

	/* ---------- Socials ---------- */
	.socials {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
		gap: 16px;
		margin-bottom: 40px;
	}
	.social {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 20px;
		transition:
			transform 0.4s var(--ease),
			border-color 0.3s;
	}
	.social:hover {
		transform: translateY(-4px);
		border-color: var(--border-strong);
	}
	.social-icon {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		flex: none;
		border-radius: 16px;
		background: var(--surface-2);
		transition: background-color 0.3s, color 0.3s, transform 0.5s var(--ease-spring);
	}
	.social:hover .social-icon {
		background: var(--accent);
		color: var(--accent-ink);
		transform: rotate(-8deg);
	}
	.social-text {
		display: grid;
		min-width: 0;
	}
	.social-text .mono {
		font-size: 0.78rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.social-go {
		margin-left: auto;
		color: var(--faint);
	}
	.network {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}

	@media (max-width: 960px) {
		.bio,
		.exp-wrap {
			grid-template-columns: 1fr;
		}
		.id-card,
		.exp-head {
			position: static;
		}
		.id-card {
			max-width: 420px;
		}
		.principles {
			grid-template-columns: 1fr 1fr;
		}
		.principle:nth-child(3) {
			padding-left: 0;
			border-left: 0;
		}
		.network {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.principles,
		.network {
			grid-template-columns: 1fr;
		}
		.principle,
		.principle + .principle {
			padding-left: 0;
			border-left: 0;
			padding-top: 24px;
		}
		.currently li {
			grid-template-columns: 1fr;
			gap: 2px;
		}
		.id-monogram {
			font-size: 7rem;
		}
	}
</style>
