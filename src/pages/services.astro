---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import { ENGAGEMENTS, SERVICES } from '../data/services';
---

<BaseLayout
	title="Services"
	description="Solution and cloud architecture, Kubernetes platforms, backend engineering, DevOps, technical advisory and team training."
>
	<PageHero
		eyebrow="Services"
		title="Expertise you can <span class='serif-em'>plug in.</span>"
		lede="Six ways I help engineering teams move faster without breaking what matters. Pick one, or combine them into an engagement that fits."
	>
		<nav class="jump" aria-label="Jump to service">
			{SERVICES.map((s) => <a class="chip" href={`#${s.id}`}>{s.title}</a>)}
		</nav>
	</PageHero>

	<section class="section-tight">
		<div class="container">
			<div class="svc-list">
				{
					SERVICES.map((s, i) => (
						<article class="svc-row card spot" id={s.id} data-reveal>
							<div class="svc-num mono">{String(i + 1).padStart(2, '0')}</div>
							<div class="svc-main">
								<span class="svc-icon">
									<Icon name={s.icon} size={26} />
								</span>
								<h2>{s.title}</h2>
								<p class="muted">{s.summary}</p>
								<div class="chip-list">
									{s.tags.map((t) => (
										<span class="chip">{t}</span>
									))}
								</div>
							</div>
							<div class="svc-deliver">
								<p class="eyebrow">What you get</p>
								<ul>
									{s.deliverables.map((d) => (
										<li>
											<Icon name="check" size={16} />
											{d}
										</li>
									))}
								</ul>
								<a class="link-arrow" href={`/contact?service=${s.id}`}>
									Discuss {s.title.split(' ')[0].toLowerCase()} work <Icon name="arrow-right" size={16} />
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHeading
				eyebrow="Engagement models"
				title="Flexible ways to <span class='serif-em'>work together.</span>"
				lede="Every engagement starts with a free 30-minute call to see if we're a fit."
			/>
			<div class="models">
				{
					ENGAGEMENTS.map((m, i) => (
						<div class:list={['model card spot', m.highlight && 'hot']} data-reveal style={`--d:${i}`}>
							{m.highlight && <span class="badge mono">Most popular</span>}
							<h3>{m.name}</h3>
							<p class="cadence mono">{m.cadence}</p>
							<p class="muted">{m.description}</p>
							<ul>
								{m.points.map((p) => (
									<li>
										<Icon name="check" size={16} />
										{p}
									</li>
								))}
							</ul>
							<a class:list={['btn', m.highlight ? 'btn-primary' : 'btn-ghost']} href="/contact">
								Let’s scope it <Icon name="arrow-right" size={16} />
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="container">
			<SectionHeading eyebrow="Process" title="From first call to <span class='serif-em'>hand-off.</span>" />
			<Process />
		</div>
	</section>

	<section class="section">
		<div class="container faq-wrap">
			<SectionHeading eyebrow="FAQ" title="Questions, <span class='serif-em'>answered.</span>" />
			<FAQ />
		</div>
	</section>
</BaseLayout>

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 8px;
	}
	.jump .chip {
		font-size: 0.78rem;
		padding: 0.45rem 0.85rem;
		transition: color 0.2s, border-color 0.2s;
	}
	.jump .chip:hover {
		color: var(--text);
		border-color: var(--accent-text);
	}

	.svc-list {
		display: grid;
		gap: 16px;
	}
	.svc-row {
		display: grid;
		grid-template-columns: 80px 1.1fr 1fr;
		gap: 32px;
		padding: clamp(24px, 4vw, 44px);
		scroll-margin-top: calc(var(--header-h) + 24px);
	}
	.svc-row:target {
		border-color: var(--accent-text);
	}
	.svc-num {
		font-size: 0.9rem;
		color: var(--faint);
	}
	.svc-main {
		display: grid;
		gap: 16px;
		align-content: start;
		justify-items: start;
	}
	.svc-icon {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 16px;
		background: var(--accent);
		color: var(--accent-ink);
		box-shadow: 0 10px 30px -10px var(--glow);
	}
	.svc-main h2 {
		font-size: clamp(1.7rem, 3vw, 2.4rem);
	}
	.svc-deliver {
		display: grid;
		gap: 16px;
		align-content: start;
		justify-items: start;
		padding: 24px;
		border-radius: var(--radius);
		background: var(--surface-2);
		border: 1px solid var(--border);
	}
	.svc-deliver ul,
	.model ul {
		display: grid;
		gap: 10px;
	}
	.svc-deliver li,
	.model li {
		display: flex;
		gap: 10px;
		align-items: flex-start;
	}
	.svc-deliver li :global(svg),
	.model li :global(svg) {
		flex: none;
		margin-top: 5px;
		color: var(--accent-text);
	}

	.models {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		align-items: stretch;
	}
	.model {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 32px;
	}
	.model .btn {
		margin-top: auto;
		align-self: flex-start;
	}
	.model h3 {
		font-size: 2rem;
	}
	.cadence {
		font-size: 0.8rem;
		color: var(--accent-text);
	}
	.model.hot {
		border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
		background:
			radial-gradient(120% 80% at 50% 0%, var(--accent-soft), transparent 60%),
			var(--surface);
	}
	.badge {
		position: absolute;
		top: 24px;
		right: 24px;
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 0.7rem;
		font-weight: 600;
	}

	.faq-wrap {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 48px;
		align-items: start;
	}

	@media (max-width: 960px) {
		.svc-row {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.svc-num {
			position: absolute;
			top: 28px;
			right: 28px;
		}
		.models,
		.faq-wrap {
			grid-template-columns: 1fr;
		}
	}
</style>
