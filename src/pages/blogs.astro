---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import { BLOGS } from '../data/blogs';
import { SOCIALS } from '../data/site';

const flagship = BLOGS.find((b) => b.flagship)!;
const rest = BLOGS.filter((b) => !b.flagship);
const topics = [...new Set(BLOGS.flatMap((b) => b.topics))];
const youtube = SOCIALS.find((s) => s.icon === 'youtube');
---

<BaseLayout
	title="Blogs"
	description="The BigBox network: BigBoxCode, BigBoxSystems, BigBoxCognition, BigBoxCipher and BigBoxQuantum."
>
	<PageHero
		eyebrow="Blogs & learning sites"
		title="The <span class='serif-em'>BigBox</span> network."
		lede={`${BLOGS.length} independent learning sites, each focused on one deep area of technology, all built on the same idea: explain hard things clearly, with code you can run.`}
	/>

	<section class="section-tight">
		<div class="container">
			<!-- Network map -->
			<div class="map card" data-reveal="scale" aria-hidden="true">
				<div class="hub">
					<span class="hub-core">BB</span>
				</div>
				{
					BLOGS.map((b, i) => (
						<span class="node" style={`--i:${i};--n:${BLOGS.length};--c:${b.accent}`}>
							<Icon name={b.icon} size={18} />
							<em>{b.name.replace('BigBox', '')}</em>
						</span>
					))
				}
				<svg class="orbits" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid meet">
					<circle cx="200" cy="200" r="150" />
					<circle cx="200" cy="200" r="95" />
				</svg>
			</div>

			<div class="flagship-row">
				<BlogCard blog={flagship} />
			</div>
			<div class="grid">
				{rest.map((b, i) => <BlogCard blog={b} index={i} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHeading
				eyebrow="Topics"
				title="What I <span class='serif-em'>write about.</span>"
				lede="Every topic across the network, from fundamentals to the frontier."
			/>
			<div class="topics" data-reveal>
				{topics.map((t, i) => <span class="topic" style={`--i:${i}`}>{t}</span>)}
			</div>

			{
				youtube && (
					<a class="yt card spot" href={youtube.href} target="_blank" rel="noopener" data-reveal>
						<span class="yt-icon">
							<Icon name="youtube" size={30} />
						</span>
						<span class="yt-text">
							<strong>Prefer video?</strong>
							<span class="muted">Walkthroughs and deep dives on YouTube · {youtube.handle}</span>
						</span>
						<Icon name="arrow-up-right" size={20} />
					</a>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	/* ---------- network map ---------- */
	.map {
		position: relative;
		height: clamp(320px, 46vw, 440px);
		margin-bottom: 16px;
		border-radius: var(--radius-lg);
		background:
			radial-gradient(circle at 50% 50%, var(--accent-soft), transparent 55%),
			var(--surface);
	}
	.orbits {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
	}
	.orbits circle {
		fill: none;
		stroke: var(--border-strong);
		stroke-dasharray: 3 6;
		animation: orbit 60s linear infinite;
		transform-origin: center;
	}
	.orbits circle:last-child {
		animation-direction: reverse;
	}
	@keyframes orbit {
		to {
			transform: rotate(360deg);
		}
	}
	.hub {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		border-radius: 28px;
		background: var(--accent);
		box-shadow: 0 0 80px var(--glow);
		animation: hub 6s ease-in-out infinite;
	}
	.hub-core {
		font-family: var(--ff-display);
		font-weight: 700;
		font-size: 2rem;
		letter-spacing: -0.06em;
		color: var(--accent-ink);
	}
	@keyframes hub {
		50% {
			transform: rotate(8deg) scale(1.04);
		}
	}
	.node {
		--angle: calc(360deg / var(--n) * var(--i) - 90deg);
		--r: clamp(110px, 24vw, 170px);
		position: absolute;
		left: 50%;
		top: 50%;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 14px 8px 10px;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
		background: var(--surface-2);
		color: var(--c);
		font-size: 0.85rem;
		white-space: nowrap;
		transform: translate(-50%, -50%) rotate(var(--angle)) translateX(var(--r)) rotate(calc(-1 * var(--angle)));
	}
	:global([data-theme='light']) .node {
		color: color-mix(in srgb, var(--c) 55%, black);
	}
	.node em {
		font-style: normal;
		font-weight: 600;
		color: var(--text);
	}
	@media (max-width: 560px) {
		.node em {
			display: none;
		}
		.node {
			padding: 10px;
		}
	}

	/* ---------- cards ---------- */
	.flagship-row {
		margin-bottom: 16px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}

	/* ---------- topics ---------- */
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.topic {
		padding: 10px 18px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--surface);
		font-family: var(--ff-display);
		font-size: clamp(0.95rem, 1.4vw, 1.1rem);
		transition: background-color 0.2s, color 0.2s, transform 0.3s var(--ease-spring);
	}
	.topic:nth-child(3n + 1) {
		font-size: clamp(1.1rem, 1.8vw, 1.4rem);
	}
	.topic:hover {
		background: var(--accent);
		color: var(--accent-ink);
		transform: rotate(-3deg) scale(1.05);
	}

	.yt {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 48px;
		padding: 24px 28px;
		transition: transform 0.4s var(--ease), border-color 0.3s;
	}
	.yt:hover {
		transform: translateY(-3px);
		border-color: #ff4e45;
	}
	.yt-icon {
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		flex: none;
		border-radius: 18px;
		background: #ff4e45;
		color: white;
	}
	.yt-text {
		display: grid;
		gap: 2px;
		margin-right: auto;
	}
	.yt-text strong {
		font-family: var(--ff-display);
		font-size: 1.3rem;
	}
</style>
