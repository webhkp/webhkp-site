---
/**
 * Generative cover art for a project: no image assets needed.
 * Uses the project's accent colour and one of four patterns.
 */
interface Props {
	title: string;
	accent: string;
	pattern: 'grid' | 'rings' | 'bars' | 'dots';
	size?: 'md' | 'lg';
}
const { title, accent, pattern, size = 'md' } = Astro.props;
const initials = title
	.split(/\s+/)
	.map((w) => w[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
const bars = [62, 38, 80, 54, 92, 46, 70, 30, 84, 58];
---

<div class:list={['cover', `p-${pattern}`, size]} style={`--c:${accent}`} aria-hidden="true">
	<div class="pattern">
		{pattern === 'rings' && [1, 2, 3, 4, 5].map((n) => <span class="ring" style={`--n:${n}`} />)}
		{
			pattern === 'bars' && (
				<div class="bars">
					{bars.map((h, i) => (
						<span style={`--h:${h}%;--i:${i}`} />
					))}
				</div>
			)
		}
	</div>
	<div class="glow"></div>
	<div class="tiles">
		<span class="t t1"></span>
		<span class="t t2"></span>
		<span class="t t3"></span>
	</div>
	<span class="initials">{initials}</span>
	<span class="chrome"><i></i><i></i><i></i></span>
</div>

<style>
	.cover {
		--c: #c8ff3d;
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: calc(var(--radius) - 6px);
		background:
			radial-gradient(120% 90% at 85% 15%, color-mix(in srgb, var(--c) 34%, transparent), transparent 60%),
			linear-gradient(160deg, color-mix(in srgb, var(--c) 10%, var(--surface-2)), var(--surface-2));
		border: 1px solid var(--border);
		isolation: isolate;
	}
	.cover.lg {
		aspect-ratio: 21 / 9;
	}
	.pattern {
		position: absolute;
		inset: 0;
		z-index: -1;
	}
	.p-grid .pattern {
		background-image:
			linear-gradient(color-mix(in srgb, var(--c) 22%, transparent) 1px, transparent 1px),
			linear-gradient(90deg, color-mix(in srgb, var(--c) 22%, transparent) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: radial-gradient(ellipse at 70% 30%, #000 10%, transparent 70%);
	}
	.p-dots .pattern {
		background-image: radial-gradient(color-mix(in srgb, var(--c) 55%, transparent) 1.4px, transparent 1.6px);
		background-size: 18px 18px;
		mask-image: linear-gradient(120deg, transparent 20%, #000 80%);
	}
	.ring {
		position: absolute;
		right: -12%;
		top: -30%;
		width: calc(var(--n) * 22%);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
		transform: translate(calc(var(--n) * 6%), 0);
	}
	.bars {
		position: absolute;
		right: 8%;
		bottom: 0;
		display: flex;
		align-items: flex-end;
		gap: 8px;
		height: 70%;
		width: 50%;
	}
	.bars span {
		flex: 1;
		height: var(--h);
		border-radius: 6px 6px 0 0;
		background: linear-gradient(to top, color-mix(in srgb, var(--c) 10%, transparent), color-mix(in srgb, var(--c) 60%, transparent));
		transform-origin: bottom;
		transition: transform 0.6s var(--ease-spring);
		transition-delay: calc(var(--i) * 30ms);
	}
	:global(.project-card:hover) .bars span {
		transform: scaleY(1.12);
	}

	.glow {
		position: absolute;
		width: 45%;
		aspect-ratio: 1;
		left: 10%;
		bottom: -30%;
		border-radius: 50%;
		background: var(--c);
		opacity: 0.18;
		filter: blur(50px);
		z-index: -1;
	}

	.tiles .t {
		position: absolute;
		border-radius: 14px;
		transition: transform 0.7s var(--ease-spring);
	}
	.t1 {
		width: 26%;
		aspect-ratio: 1;
		right: 14%;
		bottom: 16%;
		background: color-mix(in srgb, var(--c) 85%, white 0%);
		box-shadow: 0 20px 50px -10px color-mix(in srgb, var(--c) 60%, transparent);
	}
	.t2 {
		width: 16%;
		aspect-ratio: 1;
		right: 36%;
		bottom: 40%;
		border: 2px solid color-mix(in srgb, var(--c) 70%, transparent);
		backdrop-filter: blur(6px);
	}
	.t3 {
		width: 9%;
		aspect-ratio: 1;
		right: 10%;
		top: 18%;
		background: var(--text);
		opacity: 0.85;
		border-radius: 8px;
	}
	:global(.project-card:hover) .t1 {
		transform: translate(-6%, -8%) rotate(-6deg);
	}
	:global(.project-card:hover) .t2 {
		transform: translate(-14%, -10%) rotate(10deg);
	}
	:global(.project-card:hover) .t3 {
		transform: translate(10%, -10%) rotate(20deg);
	}

	.initials {
		position: absolute;
		left: 6%;
		bottom: 8%;
		font-family: var(--ff-display);
		font-weight: 700;
		font-size: clamp(3rem, 9vw, 6rem);
		line-height: 0.8;
		letter-spacing: -0.06em;
		color: transparent;
		-webkit-text-stroke: 1.5px color-mix(in srgb, var(--text) 35%, transparent);
	}
	.cover.lg .initials {
		font-size: clamp(4rem, 13vw, 10rem);
	}
	.chrome {
		position: absolute;
		left: 16px;
		top: 14px;
		display: flex;
		gap: 6px;
	}
	.chrome i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--text) 22%, transparent);
	}
</style>
