---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { NAV, SITE, SOCIALS } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const mobileNav = [{ label: 'Home', href: '/' }, ...NAV, { label: 'Contact', href: '/contact' }];
---

<header class="site-header" data-header>
	<div class="container bar">
		<a href="/" class="brand" aria-label={`${SITE.name} home`}><Logo /></a>

		<nav class="nav" aria-label="Primary">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="actions">
			<button class="icon-btn cmdk-btn" type="button" data-cmdk-open aria-label="Search and quick navigation">
				<Icon name="search" size={16} />
				<span class="kbd" data-mod-key>⌘K</span>
			</button>
			<button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Toggle light and dark theme">
				<Icon name="sun" size={18} class="i-sun" />
				<Icon name="moon" size={18} class="i-moon" />
			</button>
			<a class="btn btn-primary btn-sm cta" href="/contact">Let’s talk <Icon name="arrow-right" size={16} /></a>
			<button
				class="icon-btn menu-btn"
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu"
			>
				<span class="burger" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
		<nav class="container" aria-label="Mobile">
			<ol>
				{
					mobileNav.map((item, i) => (
						<li style={`--i:${i}`}>
							<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
								<span class="num mono">{String(i + 1).padStart(2, '0')}</span>
								{item.label}
							</a>
						</li>
					))
				}
			</ol>
			<div class="mobile-socials">
				{
					SOCIALS.map((s) => (
						<a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
							<Icon name={s.icon} size={18} />
						</a>
					))
				}
			</div>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		view-transition-name: site-header;
	}
	.bar {
		height: var(--header-h);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 10px;
		padding: 0 10px 0 18px;
		border-radius: 999px;
		border: 1px solid transparent;
		transition:
			background-color 0.35s var(--ease),
			border-color 0.35s var(--ease),
			height 0.35s var(--ease),
			box-shadow 0.35s var(--ease);
	}
	.site-header[data-scrolled] .bar,
	.site-header[data-menu-open] .bar {
		height: 60px;
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(18px) saturate(1.4);
		-webkit-backdrop-filter: blur(18px) saturate(1.4);
		border-color: var(--border);
		box-shadow: 0 10px 40px -20px rgba(0, 0, 0, 0.5);
	}

	.nav ul {
		display: flex;
		gap: 2px;
		padding: 4px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface) 55%, transparent);
	}
	.nav a {
		display: block;
		padding: 8px 14px;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--muted);
		transition: color 0.2s, background-color 0.2s;
	}
	.nav a:hover {
		color: var(--text);
		background: var(--surface-2);
	}
	.nav a[aria-current='page'] {
		color: var(--text);
		background: var(--surface-3);
		box-shadow: inset 0 0 0 1px var(--border-strong);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.cmdk-btn {
		grid-auto-flow: column;
		padding: 0 8px 0 12px;
	}
	.theme-btn {
		position: relative;
		width: 40px;
	}
	.theme-btn :global(svg) {
		grid-area: 1 / 1;
		transition: transform 0.5s var(--ease-spring), opacity 0.3s;
	}
	:global([data-theme='dark']) .theme-btn :global(.i-sun),
	:global([data-theme='light']) .theme-btn :global(.i-moon) {
		opacity: 0;
		transform: rotate(-90deg) scale(0.5);
	}

	.menu-btn {
		display: none;
		width: 44px;
		height: 44px;
	}
	.burger {
		display: grid;
		gap: 6px;
		width: 18px;
	}
	.burger span {
		height: 2px;
		border-radius: 2px;
		background: var(--text);
		transition: transform 0.35s var(--ease);
	}
	.site-header[data-menu-open] .burger span:first-child {
		transform: translateY(4px) rotate(45deg);
	}
	.site-header[data-menu-open] .burger span:last-child {
		transform: translateY(-4px) rotate(-45deg);
	}

	.mobile-menu {
		position: fixed;
		inset: 0;
		z-index: -1;
		padding-top: calc(var(--header-h) + 40px);
		background: var(--bg);
		overflow-y: auto;
	}
	.mobile-menu ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
	}
	.mobile-menu li {
		border-bottom: 1px solid var(--border);
		animation: menu-in 0.5s var(--ease) both;
		animation-delay: calc(var(--i) * 45ms);
	}
	.mobile-menu li a {
		display: flex;
		align-items: baseline;
		gap: 16px;
		padding: 16px 4px;
		font-family: var(--ff-display);
		font-size: clamp(1.8rem, 8vw, 2.6rem);
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	.mobile-menu li a[aria-current='page'] {
		color: var(--accent-text);
	}
	.mobile-menu .num {
		font-size: 0.8rem;
		color: var(--faint);
	}
	.mobile-socials {
		display: flex;
		gap: 10px;
		padding: 32px 0 48px;
	}
	.mobile-socials .icon-btn {
		width: 48px;
		height: 48px;
	}
	@keyframes menu-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

	@media (max-width: 1080px) {
		.nav a {
			padding: 8px 10px;
		}
	}
	@media (max-width: 960px) {
		.nav {
			display: none;
		}
		.menu-btn {
			display: inline-grid;
		}
	}
	@media (max-width: 560px) {
		.cta,
		.cmdk-btn .kbd {
			display: none;
		}
		.bar {
			padding-left: 14px;
		}
	}
</style>
