---
import Icon from './Icon.astro';
import { FAQ as ITEMS } from '../data/services';

interface Props {
	limit?: number;
}
const { limit } = Astro.props;
const items = limit ? ITEMS.slice(0, limit) : ITEMS;
---

<div class="faq">
	{
		items.map((item, i) => (
			<details class="faq-item" data-reveal style={`--d:${i}`} open={i === 0}>
				<summary>
					<span>{item.q}</span>
					<span class="toggle" aria-hidden="true">
						<Icon name="plus" size={18} />
					</span>
				</summary>
				<p class="muted">{item.a}</p>
			</details>
		))
	}
</div>

<style>
	.faq {
		display: grid;
		gap: 10px;
	}
	.faq-item {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		transition: border-color 0.3s, background-color 0.3s;
	}
	.faq-item[open] {
		border-color: var(--border-strong);
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 20px 22px;
		cursor: pointer;
		list-style: none;
		font-family: var(--ff-display);
		font-size: 1.12rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.toggle {
		flex: none;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
		transition: transform 0.4s var(--ease-spring), background-color 0.3s, color 0.3s;
	}
	.faq-item[open] .toggle {
		transform: rotate(45deg);
		background: var(--accent);
		color: var(--accent-ink);
		border-color: transparent;
	}
	.faq-item p {
		padding: 0 22px 22px;
		max-width: 70ch;
	}
</style>
